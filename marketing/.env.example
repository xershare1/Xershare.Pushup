# Copy to .env.development or set in your static host env UI.
# PushupPros product app — no trailing slash.
VITE_CHALLENGE_APP_URL=http://localhost:5174

# Optional: override sign-in / sign-up URLs (defaults to CHALLENGE_APP_URL/sign-in and /sign-up).
# VITE_APP_SIGN_IN_URL=https://your-app/sign-in
# VITE_APP_SIGN_UP_URL=https://your-app/sign-up

# Marketing nav "Open app →" (defaults to CHALLENGE_APP_URL).
# VITE_APP_OPEN_URL=https://app.pushuppros.com

# Footer Contact mailto (defaults to mailto:support@pushuppros.com).
# VITE_CONTACT_MAILTO=mailto:hello@example.com
