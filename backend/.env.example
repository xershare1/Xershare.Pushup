# Copy to .env and fill values. Loaded automatically when the API starts (see app/main.py).

# PostgreSQL (Alembic + future SQLAlchemy persistence). Example for local Docker:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pushup
# DATABASE_URL=

# Max challenges per Clerk user per day when DATABASE_URL is set (default 100)
# CHALLENGE_RATE_LIMIT_DAILY=100

# Validation: max reps per attempt (default 500); proposed challenges expire after N hours (default 48)
# CHALLENGE_MAX_PUSHUPS=500
# CHALLENGE_EXPIRY_HOURS=48

# Challenge attempt video list/display retention (default 24h)
# VIDEO_TTL_HOURS=24

# Solo sessions (browser-direct S3 single PUT or multipart); row + S3 video TTL (default 720h ~30 days)
# SOLO_VIDEO_TTL_HOURS=720
# SOLO_MAX_REPS=1000000
# Default solo max video ~200MiB — raise SOLO_MAX_VIDEO_BYTES if needed
# SOLO_MAX_VIDEO_BYTES=209715200
# MPU when size >= threshold (default 100 MiB)
# SOLO_MULTIPART_THRESHOLD_BYTES=104857600
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# Uses default AWS credential chain when bucket is set (e.g. IAM role or AWS_ACCESS_KEY_ID)

# Playback: CloudFront signed GET URLs. Omit to fall back to S3 presigned GET.
# CLOUDFRONT_VIDEO_DOMAIN=d111111abcdef8.cloudfront.net
# CLOUDFRONT_VIDEO_KEY_PAIR_ID=K1234567890ABC
# CLOUDFRONT_VIDEO_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"
# CLOUDFRONT_VIDEO_PRIVATE_KEY_PEM_FILE=C:/secrets/cloudfront_rsa_private.pem
# Cache-Control metadata on uploaded objects for CDN
# SOLO_VIDEO_CACHE_CONTROL=private, max-age=3600

# Vite / browser origin (no trailing slash). Must match how you open the app.
FRONTEND_URL=http://localhost:5174

# Optional: extra allowed origins (comma-separated), e.g. staging URL
# CORS_EXTRA_ORIGINS=

# Comma-separated Clerk user ids (`user_...`) with access to GET/POST /admin/* (support dashboard).
# When empty, no one can use admin APIs.
# ADMIN_CLERK_USER_IDS=user_2abc...

# Clerk — Backend API → session JWT verification (Dashboard → Configure → API keys)
# JWKS URL is often: https://<your-frontend-api-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Issuer must match the `iss` claim on session tokens (same host as Frontend API in Clerk)
CLERK_JWT_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Backend API (GET /v1/users/{id} for POST /users/sync profile + public_metadata for challenge prefs)
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CHALLENGER=price_...
STRIPE_PRICE_PRO=price_...
