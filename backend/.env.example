# Copy to .env and fill values. Loaded automatically when the API starts (see app/main.py).

# PostgreSQL (Alembic + future SQLAlchemy persistence). Example for local Docker:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pushup
# DATABASE_URL=

# Max challenges per Clerk user per day when DATABASE_URL is set (default 100)
# CHALLENGE_RATE_LIMIT_DAILY=100

# Validation: max reps per attempt (default 500); incomplete challenges expire after N hours (default 168)
# CHALLENGE_MAX_PUSHUPS=500
# CHALLENGE_EXPIRY_HOURS=168

# Solo sessions (POST /solo/session): row + video TTL (hours), optional S3 for ephemeral video
# VIDEO_TTL_HOURS=24
# SOLO_MAX_REPS=1000000
# SOLO_MAX_VIDEO_BYTES=52428800
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
# Uses default AWS credential chain when bucket is set (e.g. IAM role or AWS_ACCESS_KEY_ID)

# Vite / browser origin (no trailing slash). Must match how you open the app.
FRONTEND_URL=http://localhost:5174

# Optional: extra allowed origins (comma-separated), e.g. staging URL
# CORS_EXTRA_ORIGINS=

# Clerk — Backend API → session JWT verification (Dashboard → Configure → API keys)
# JWKS URL is often: https://<your-frontend-api-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Issuer must match the `iss` claim on session tokens (same host as Frontend API in Clerk)
CLERK_JWT_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Backend API (user lookup, public_metadata for challenge notification prefs)
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CHALLENGER=price_...
STRIPE_PRICE_PRO=price_...
