# Copy to .env and fill values. Loaded automatically when the API starts (see app/main.py).

# Vite / browser origin (no trailing slash). Must match how you open the app.
FRONTEND_URL=http://localhost:5174

# Optional: extra allowed origins (comma-separated), e.g. staging URL
# CORS_EXTRA_ORIGINS=

# Clerk — Backend API → session JWT verification (Dashboard → Configure → API keys)
# JWKS URL is often: https://<your-frontend-api-domain>/.well-known/jwks.json
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
# Issuer must match the `iss` claim on session tokens (same host as Frontend API in Clerk)
CLERK_JWT_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
# Backend API (user lookup, public_metadata for challenge notification prefs)
CLERK_SECRET_KEY=sk_test_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CHALLENGER=price_...
STRIPE_PRICE_PRO=price_...
